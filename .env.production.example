APP_ENV=production
SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARACTERS
DATABASE_URL=postgresql+psycopg://orbiserp:REPLACE_PASSWORD@postgres-host:5432/orbiserp
COOKIE_SECURE=1
AUTO_CREATE_SCHEMA=0
TRUST_PROXY=1
FISCAL_MODE=disabled
SESSION_HOURS=12
MAX_UPLOAD_MB=50
STORAGE_ROOT=/app/storage

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_DEFAULT_SENDER=mailer@example.com
REQUIRE_EMAIL_VERIFICATION=1
VERIFY_EMAIL_MAX_AGE_HOURS=24
VERIFY_EMAIL_CODE_MINUTES=10
VERIFY_EMAIL_MAX_ATTEMPTS=5

# Para implantaciones gestionadas deja 0. Para SaaS autoservicio cambia a 1
# únicamente después de publicar documentos legales revisados.
PUBLIC_REGISTRATION=0
TERMS_URL=https://example.com/legal/terms
PRIVACY_URL=https://example.com/legal/privacy
LEGAL_VERSION=2026-01

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BILLING_MODE=manual
BILLING_WEBHOOK_SECRET=REPLACE_IF_WEBHOOK_MODE
FREECURRENCY_API_KEY=
RATE_LIMIT_STORAGE=database
CRON_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS

BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_HOURS=30
BACKUP_MIRROR_DIR=
MAINTENANCE_INTERVAL_SECONDS=86400
MAINTENANCE_RETENTION_DAYS=30
STARTUP_INTEGRITY_CHECK=1

LOG_LEVEL=INFO
LOG_JSON=1
RELEASE_VERSION=2026.08.13
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_SECRET=
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=60000
PUBLIC_BASE_URL=https://erp.example.com

# Commercial plan display prices (USD; limits come from application code)
PLAN_BASIC_PRICE_USD=29
PLAN_PRO_PRICE_USD=69
PLAN_ULTRA_PRICE_USD=149
