APP_ENV=development
SECRET_KEY=change-this-with-a-random-value-of-at-least-32-characters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_inventario
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=0
AUTO_CREATE_SCHEMA=1
FISCAL_MODE=disabled
SESSION_HOURS=12
MAX_UPLOAD_MB=50
STORAGE_ROOT=storage
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
BILLING_WEBHOOK_SECRET=
BILLING_MODE=manual
FREECURRENCY_API_KEY=
RATE_LIMIT_STORAGE=database
CRON_SECRET=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Seguridad / alta de cuentas
PUBLIC_REGISTRATION=1
REQUIRE_EMAIL_VERIFICATION=0
VERIFY_EMAIL_MAX_AGE_HOURS=24
VERIFY_EMAIL_CODE_MINUTES=10
VERIFY_EMAIL_MAX_ATTEMPTS=5

# Operación y mantenimiento
BACKUP_MAX_AGE_HOURS=30
STARTUP_INTEGRITY_CHECK=1
MAINTENANCE_INTERVAL_SECONDS=86400
MAINTENANCE_RETENTION_DAYS=30
LOG_LEVEL=INFO
LOG_JSON=0
# Opcional: directorio montado en otra infraestructura para duplicar cada backup.
BACKUP_MIRROR_DIR=
TERMS_URL=https://example.com/terms
PRIVACY_URL=https://example.com/privacy
LEGAL_VERSION=draft
# Webhook opcional de incidentes 5xx (sin payloads de formularios)
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_SECRET=
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=60000
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Commercial plan display prices (USD; limits come from application code)
PLAN_BASIC_PRICE_USD=29
PLAN_PRO_PRICE_USD=69
PLAN_ULTRA_PRICE_USD=149
